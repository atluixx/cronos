JWT_SECRET=change-me-to-a-long-random-string

# SQLite database used by Prisma. A *relative* `file:` URL resolves against the
# schema directory (backend/prisma). On hosts like Square Cloud / Discloud use an
# absolute path inside the instance's writable storage, and pass the SAME value
# to `prisma migrate deploy` (see backend/squarecloud.config).
#   Square Cloud:  DATABASE_URL="file:/application/data/cronos.db"
#   Discloud:      DATABASE_URL="file:./data/dev.db"
DATABASE_URL="file:./dev.db"

# BullMQ queue/worker backend.
REDIS_URL="redis://127.0.0.1:6379"

# Web port. Square Cloud sites must listen on 80; Discloud sites on 8080.
PORT=4000

# Directory where uploaded media (baileys files, template previews) are stored.
MEDIA_DIR="./media"