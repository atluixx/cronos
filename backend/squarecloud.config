MAIN=src/index.ts
MEMORY=1024
VERSION=recommended
DISPLAY_NAME=Cronos
DESCRIPTION=WhatsApp group message scheduler
SUBDOMAIN=cronos
START=mkdir -p /application/data /application/media && DATABASE_URL=file:/application/data/cronos.db npx prisma migrate deploy && DATABASE_URL=file:/application/data/cronos.db PORT=80 MEDIA_DIR=/application/media npx tsx src/index.ts
AUTORESTART=true